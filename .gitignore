# Made in cooperation with ChatGPT

# Python cache and compiled files
__pycache__/
*.py[cod]
.pytest_cache/

# Virtual environments
.venv/
venv/

# Local databases
*.db
*.sqlite
*.sqlite3

# Environment variables and secrets
.env
.env.*

# Editor settings
.vscode/

# Operating system files
.DS_Store
Thumbs.db

# Unnecessary desciption files

RADIATION_ALGORITHM_V4.md
INSTALL_RADIATION_ALGORITHM_V4.txt
*.txt
*v5.md
*v6.md

cat >> .gitignore <<'EOF'

# Python-generated files
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
env/

# Local databases and SQLite journals
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Runtime sensor logs
data/sensor_logs/
*.log

# Retired files from previous updates
*.retired
*.retired.*
EOF
