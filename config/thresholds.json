  "condition_cutoffs": [
    {
      "condition_id": "space_motion_sickness",
      "signal": "symptom_duration_hours",
      "operator": "gt",
      "value": 72,
      "unit": "hours",
      "meaning": "Worst case: severe and persistent symptoms lasting over 72 h.",
      "source": "RESEARCHERS_DATA (IMM)"
    },
    {
      "condition_id": "nasal_congestion",
      "signal": "symptom_duration_hours",
      "operator": "gt",
      "value": 72,
      "unit": "hours",
      "meaning": "Worst case: complete obstruction needing 72-168 h (3-7 days) of treatment. Best case: 0-72 h.",
      "source": "RESEARCHERS_DATA (IMM)"
    },
    {
      "condition_id": "urinary_incontinence",
      "signal": "symptom_duration_hours",
      "operator": "gt",
      "value": 24,
      "unit": "hours",
      "meaning": "Moderate to severe course: Clinical Phase II lasts 24-120 h. Best case: 0-24 h.",
      "source": "RESEARCHERS_DATA (IMM)"
    },
    {
      "condition_id": "urinary_retention",
      "signal": "symptom_duration_hours",
      "operator": "gt",
      "value": 24,
      "unit": "hours",
      "meaning": "Needs repeated or indwelling catheterisation: 24-120 h. Best case: 0-24 h. Catheterisation failure risk under 1% may require medical evacuation.",
      "source": "RESEARCHERS_DATA (IMM)"
    },
    {
      "condition_id": "back_pain_space_adaptation",
      "signal": "mission_day",
      "operator": "between",
      "value": [
        2,
        5
      ],
      "unit": "mission day",
      "meaning": "Typical onset window of space-adaptation back pain (first 2-5 days of flight).",
      "source": "RESEARCHERS_DATA"
    }
  ],
